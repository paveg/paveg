{
  "name": "paveg-profile",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "generate": "node scripts/generate.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.0"
}
